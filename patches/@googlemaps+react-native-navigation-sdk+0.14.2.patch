 @implementation ObjectTranslationUtil
 
++ (BOOL)isClusterMarkerImagePath:(nullable NSString *)imagePath {
+  return imagePath != nil && [imagePath hasPrefix:kClusterMarkerPrefix];
+}
+
++ (CGSize)markerTargetSizeForImage:(UIImage *)image
+                         imagePath:(nullable NSString *)imagePath
+                         draggable:(BOOL)draggable {
+  CGImageRef cgImage = image.CGImage;
+  CGFloat screenScale = UIScreen.mainScreen.scale > 0 ? UIScreen.mainScreen.scale : 1.0;
+  CGFloat baseWidth = image.size.width;
+  CGFloat baseHeight = image.size.height;
+
+  if (cgImage != nil) {
+    baseWidth = (CGFloat)CGImageGetWidth(cgImage) / screenScale;
+    baseHeight = (CGFloat)CGImageGetHeight(cgImage) / screenScale;
+  }
+
+  CGFloat targetWidth = draggable
+                            ? kDraggableMarkerBaseWidth
+                            : ([self isClusterMarkerImagePath:imagePath] ? kClusterMarkerBaseWidth
+                                                                         : kMarkerBaseWidth);
+  CGFloat aspectRatio = baseHeight > 0 ? baseWidth / baseHeight : 1.0;
+  CGFloat targetHeight = MAX(targetWidth / MAX(aspectRatio, 0.01), 1.0);
+
+  return CGSizeMake(targetWidth, targetHeight);
+}
+
++ (void)applyMarkerIcon:(nullable UIImage *)icon
+               toMarker:(GMSMarker *)marker
+              imagePath:(nullable NSString *)imagePath
+              draggable:(BOOL)draggable {
+  if (icon == nil) {
+    marker.icon = nil;
+    marker.iconView = nil;
+    marker.tracksViewChanges = YES;
+    marker.groundAnchor = CGPointMake(0.5, 1.0);
+    return;
+  }
+
+  CGSize targetSize = [self markerTargetSizeForImage:icon imagePath:imagePath draggable:draggable];
+  UIImageView *iconView = [[UIImageView alloc] initWithImage:icon];
+  iconView.contentMode = UIViewContentModeScaleAspectFit;
+  iconView.frame = CGRectMake(0, 0, targetSize.width, targetSize.height);
+  iconView.clipsToBounds = NO;
+  marker.icon = nil;
+  marker.iconView = iconView;
+  marker.tracksViewChanges = NO;
+  marker.groundAnchor =
+      [self isClusterMarkerImagePath:imagePath] ? CGPointMake(0.5, 0.5) : CGPointMake(0.5, 1.0);
+}
