+  private BitmapDescriptor createMarkerIconDescriptor(
+      String effectiveId, String imagePath, float scale) throws IOException {
+    String cachedImagePath = markerImagePathMap.get(effectiveId);
+    Bitmap baseBitmap =
+        imagePath.equals(cachedImagePath) ? markerBaseBitmapMap.get(effectiveId) : null;
+
+    if (baseBitmap == null) {
+      baseBitmap = loadMarkerBitmap(imagePath);
+
+      if (baseBitmap == null) {
+        throw new IOException("Could not decode marker asset");
+      }
+
+      markerBaseBitmapMap.put(effectiveId, baseBitmap);
+    }
+
+    if (scale == 1f) {
+      return BitmapDescriptorFactory.fromBitmap(baseBitmap);
+    }
+
+    Bitmap scaledBitmap =
+        Bitmap.createScaledBitmap(
+            baseBitmap,
+            Math.round(baseBitmap.getWidth() * scale),
+            Math.round(baseBitmap.getHeight() * scale),
+            true);
+    return BitmapDescriptorFactory.fromBitmap(scaledBitmap);
+  }
+
+  private Bitmap loadMarkerBitmap(String imagePath) throws IOException {
+    Activity activity = activitySupplier != null ? activitySupplier.get() : null;
+    if (activity == null) {
+      throw new IOException("No activity available");
+    }
+
+    if (imagePath.startsWith(CLUSTER_MARKER_PREFIX)) {
+      return createClusterMarkerBitmap(imagePath.substring(CLUSTER_MARKER_PREFIX.length()));
+    }
+
+    if (imagePath.startsWith("http://") || imagePath.startsWith("https://")) {
+      HttpURLConnection connection = (HttpURLConnection) new URL(imagePath).openConnection();
+      connection.setDoInput(true);
+      connection.connect();
+
+      try (InputStream inputStream = connection.getInputStream()) {
+        return BitmapFactory.decodeStream(inputStream);
+      } finally {
+        connection.disconnect();
+      }
+    }
+
+    if (imagePath.startsWith("content://") || imagePath.startsWith("file://")) {
+      Uri uri = Uri.parse(imagePath);
+      try (InputStream inputStream = activity.getContentResolver().openInputStream(uri)) {
+        return inputStream != null ? BitmapFactory.decodeStream(inputStream) : null;
+      }
+    }
+
+    if (imagePath.startsWith("/")) {
+      return BitmapFactory.decodeFile(imagePath);
+    }
+
+    try (InputStream inputStream = activity.getAssets().open(imagePath)) {
+      return BitmapFactory.decodeStream(inputStream);
+    }
+  }
+
+  private Bitmap createClusterMarkerBitmap(String label) {
+    Activity activity = activitySupplier != null ? activitySupplier.get() : null;
+    float density = activity != null ? activity.getResources().getDisplayMetrics().density : 1f;
+    int size = Math.max(420, Math.round(168 * density));
+    Bitmap bitmap = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888);
+    Canvas canvas = new Canvas(bitmap);
+
+    Paint haloPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    haloPaint.setColor(Color.parseColor("#33111827"));
+    canvas.drawCircle(size / 2f, size / 2f, size * 0.42f, haloPaint);
+
+    Paint fillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    fillPaint.setColor(Color.parseColor("#111827"));
+    canvas.drawCircle(size / 2f, size / 2f, size * 0.32f, fillPaint);
+
+    Paint strokePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    strokePaint.setColor(Color.parseColor("#0F172A"));
+    strokePaint.setStyle(Paint.Style.STROKE);
+    strokePaint.setStrokeWidth(size * 0.03f);
+    canvas.drawCircle(size / 2f, size / 2f, size * 0.32f, strokePaint);
+
+    Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    textPaint.setColor(Color.WHITE);
+    textPaint.setTextAlign(Paint.Align.CENTER);
+    textPaint.setTypeface(Typeface.create(Typeface.DEFAULT_BOLD, Typeface.BOLD));
+    textPaint.setTextSize(label.length() > 2 ? size * 0.18f : size * 0.21f);
+
+    Paint.FontMetrics fontMetrics = textPaint.getFontMetrics();
+    float baseline = size / 2f - ((fontMetrics.ascent + fontMetrics.descent) / 2f);
+    canvas.drawText(label, size / 2f, baseline, textPaint);
+
+    return bitmap;
+  }
+
+  private float resolveMarkerScale(String imagePath, boolean draggable) {
+    if (draggable) {
+      return DRAGGABLE_MARKER_BASE_SCALE;
+    }
+
+    if (imagePath != null && imagePath.startsWith(CLUSTER_MARKER_PREFIX)) {
+      return CLUSTER_MARKER_SCALE;
+    }
+
+    return CUSTOM_MARKER_BASE_SCALE;
+  }
+
+  private void animateDraggableMarker(Marker marker, boolean lifted) {
+    String effectiveId = getMarkerEffectiveId(marker.getId());
+    String imagePath = markerImagePathMap.get(effectiveId);
+
+    if (imagePath == null || imagePath.isEmpty()) {
+      return;
+    }
+
+    float startScale =
+        markerScaleMap.containsKey(effectiveId)
+            ? markerScaleMap.get(effectiveId)
+            : DRAGGABLE_MARKER_BASE_SCALE;
+    float targetScale = lifted ? DRAGGABLE_MARKER_ACTIVE_SCALE : DRAGGABLE_MARKER_BASE_SCALE;
+
+    if (Math.abs(startScale - targetScale) < 0.01f) {
+      return;
+    }
+
+    ValueAnimator animator = ValueAnimator.ofFloat(startScale, targetScale);
+    animator.setDuration(lifted ? 190L : 160L);
+    animator.setInterpolator(
+        lifted ? new OvershootInterpolator(0.7f) : new DecelerateInterpolator());
+    animator.addUpdateListener(
+        animation -> {
+          try {
+            float scale = (float) animation.getAnimatedValue();
+            marker.setIcon(createMarkerIconDescriptor(effectiveId, imagePath, scale));
+            markerScaleMap.put(effectiveId, scale);
+          } catch (IOException ignored) {
+            // Keep the last valid icon if a single animation frame fails to load.
+          }
+        });
+    animator.start();
+  }
