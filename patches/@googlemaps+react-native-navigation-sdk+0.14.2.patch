 using namespace JS::NativeNavAutoModule;
 
+static UIImage *LoadMarkerImage(NSString *imgPath) {
+  if (!imgPath || ![imgPath isKindOfClass:[NSString class]]) {
+    return nil;
+  }
+
+  NSString *trimmedPath =
+      [imgPath stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+  if (trimmedPath.length == 0) {
+    return nil;
+  }
+
+  NSMutableOrderedSet<NSString *> *candidates = [NSMutableOrderedSet orderedSet];
+  NSArray<NSString *> *rawCandidates = @[
+    trimmedPath,
+    trimmedPath.stringByDeletingPathExtension,
+    trimmedPath.lastPathComponent,
+    trimmedPath.lastPathComponent.stringByDeletingPathExtension
+  ];
+
+  for (NSString *candidate in rawCandidates) {
+    if (candidate.length > 0) {
+      [candidates addObject:candidate];
+    }
+  }
+
+  for (NSString *candidate in candidates) {
+    UIImage *icon =
+        [UIImage imageNamed:candidate
+                   inBundle:NSBundle.mainBundle
+      compatibleWithTraitCollection:nil];
+    if (!icon) {
+      icon = [UIImage imageNamed:candidate];
+    }
+    if (icon) {
+      return icon;
+    }
+
+    NSString *extension = candidate.pathExtension;
+    NSString *resourceName = candidate.stringByDeletingPathExtension;
+    NSString *resourcePath = [NSBundle.mainBundle pathForResource:resourceName
+                                                          ofType:extension.length > 0 ? extension
+                                                                                     : nil];
+    if (resourcePath.length > 0) {
+      icon = [UIImage imageWithContentsOfFile:resourcePath];
+      if (icon) {
+        return icon;
+      }
+    }
+  }
+
+  return nil;
+}
+
 @implementation NavAutoModule
 
