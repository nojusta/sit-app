APPWRITE_PROJECT_NAME="sit"

# Public Appwrite API endpoint, usually https://<region>.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Appwrite project ID from Project settings -> General
APPWRITE_PROJECT_ID=

# Database ID containing SIT marker documents
APPWRITE_DATABASE_ID=

# Collection ID used for the markers collection
APPWRITE_MARKERS_COLLECTION_ID=

# Collection ID used for user ratings on markers
APPWRITE_RATINGS_COLLECTION_ID=

# Storage bucket ID used for profile picture uploads
APPWRITE_STORAGE_ID=

# Google Cloud project used for the long-term Google-native map/navigation stack
GOOGLE_CLOUD_PROJECT_ID=

# Optional full path to gcloud if it is not on PATH
GCLOUD_BIN=

# Billing account used for budget guardrails and mobile SDK billing
GOOGLE_CLOUD_BILLING_ACCOUNT_ID=

# Preferred: separate mobile keys restricted by platform and app identity
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Legacy fallback only. Leave empty unless you intentionally share one key.
GOOGLE_MAPS_API_KEY=

# Best-practice defaults for this repo
GOOGLE_MAPS_ANDROID_PACKAGE_NAME=com.sitapp
GOOGLE_MAPS_IOS_BUNDLE_ID=com.sitapp

# Signing fingerprints for separate Android debug/release keys
GOOGLE_MAPS_ANDROID_DEBUG_SHA1=
GOOGLE_MAPS_ANDROID_RELEASE_SHA1=

# Optional map styling IDs for the future native Google map stack
GOOGLE_MAPS_ANDROID_MAP_ID=
GOOGLE_MAPS_IOS_MAP_ID=

# Optional monthly budget guardrail
GOOGLE_MAPS_MONTHLY_BUDGET_AMOUNT=20
GOOGLE_MAPS_BUDGET_CURRENCY=EUR


# EVERYTHING BELOW THIS LINE IS OPTIONAL

# Optional dev-only credentials for the "Dev Log" button on the landing screen
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server API key with the scopes your Codex automation needs
APPWRITE_API_KEY=

# Optional Appwrite REST response version for the MCP server
APPWRITE_API_RESPONSE_FORMAT=1.8.0

# Optional safety valve for the generic MCP request tool
APPWRITE_MCP_ALLOW_DELETE=false
