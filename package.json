{
  "name": "sit-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "scripts": {
    "start": "node ./scripts/expo.js start",
    "postinstall": "patch-package --error-on-fail",
    "prepare": "husky",
    "reset-project": "node ./scripts/reset-project.js",
    "mcp:appwrite": "node ./scripts/appwrite-mcp.js",
    "mcp:google-maps": "node ./scripts/google-maps-mcp.js",
    "appwrite:sync-markers": "node ./scripts/sync-markers-appwrite.js",
    "appwrite:sync-ratings": "node ./scripts/sync-ratings-appwrite.js",
    "appwrite:sync-favorites": "node ./scripts/sync-favorites-appwrite.js",
    "appwrite:sync-moderation-warnings": "node ./scripts/sync-moderation-warnings-appwrite.js",
    "android": "expo run:android",
    "ios": "node ./scripts/expo.js run:ios",
    "ios:device": "node ./scripts/expo.js run:ios --device",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --runInBand --watch=false",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run type-check && npm run test:ci",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "{app,src,scripts}/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.config.js": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|@react-navigation|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-native-svg|standard-navigation|native-base)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@googlemaps/react-native-navigation-sdk": "0.14.2",
    "appwrite": "^16.0.2",
    "expo": "~57.0.28",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "expo-asset": "~57.0.19",
    "react-native-animatable": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.6",
    "lint-staged": "^16.4.0",
    "nativewind": "^2.0.11",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.3.2",
    "typescript": "~6.0.3",
    "babel-preset-expo": "~57.0.15",
    "dotenv": "^18.0.7",
    "@react-native/jest-preset": "0.86.3",
    "globals": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "tar": "^7.5.22",
    "shell-quote": "^1.12.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@googlemaps/react-native-navigation-sdk"
        ]
      }
    }
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.3": false
  },
  "packageManager": "npm@11.21.0"
}
