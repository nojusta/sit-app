{
  "name": "sit-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "prepare": "husky",
    "reset-project": "node ./scripts/reset-project.js",
    "mcp:appwrite": "node ./scripts/appwrite-mcp.js",
    "mcp:google-maps": "node ./scripts/google-maps-mcp.js",
    "appwrite:sync-markers": "node ./scripts/sync-markers-appwrite.js",
    "appwrite:sync-ratings": "node ./scripts/sync-ratings-appwrite.js",
    "appwrite:sync-favorites": "node ./scripts/sync-favorites-appwrite.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --runInBand --watch=false",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run type-check && npm run test:ci",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "{app,src,scripts}/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.config.js": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|@react-navigation|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-native-svg|native-base)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@googlemaps/react-native-navigation-sdk": "^0.14.2",
    "@react-navigation/native": "^7.0.14",
    "appwrite": "^16.0.2",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "^18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "^8.0.11",
    "expo-location": "~19.0.8",
    "expo-router": "^6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "metro-config": "^0.83.3",
    "metro-resolver": "^0.83.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.17",
    "lint-staged": "^16.4.0",
    "metro": "^0.83.3",
    "nativewind": "^2.0.11",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-native-animatable": "^1.4.0",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "3.3.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.12",
    "fast-xml-parser": "^5.3.4",
    "tar": "^7.4.3"
  },
  "private": true
}
